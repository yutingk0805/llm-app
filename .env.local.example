# Copy to .env.local and fill in after `terraform apply`.
# AWS credentials are read from your shell/CLI profile (aws configure), NOT here.

AWS_REGION=ap-southeast-2

# Claude Haiku 4.5 Australia cross-region inference profile (default in code).
BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0

# From `terraform output` after apply.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
